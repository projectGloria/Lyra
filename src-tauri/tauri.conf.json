{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "distDir": "../src",
    "devPath": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Lyra",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": {
        "all": false,
        "open": true,
        "save": true,
        "message": true,
        "ask": false,
        "confirm": false
      },
      "window": {
        "all": false,
        "close": true,
        "minimize": true,
        "maximize": true,
        "unmaximize": true,
        "startDragging": true
      },
      "protocol": {
        "all": false,
        "asset": true,
        "assetScope": []
      }
    },
    "systemTray": {
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": false
    },
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "Lyra",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "fileDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' file: data: blob: https://asset.localhost http://asset.localhost asset:; media-src 'self' file: data: blob: https://asset.localhost http://asset.localhost asset:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none';"
    },
    "bundle": {
      "active": true,
      "targets": [
        "nsis"
      ],
      "identifier": "com.lyra.sona",
      "publisher": "Lyra",
      "copyright": "",
      "category": "Music",
      "shortDescription": "Lyra music player",
      "longDescription": "A local-folder music player. Every folder with audio becomes a playlist.",
      "icon": [
        "icons/icon.ico"
      ],
      "resources": [],
      "externalBin": [],
      "windows": {
        "nsis": {
          "installMode": "currentUser",
          "template": "installer/installer.nsi"
        }
      }
    },
    "updater": {
      "active": false
    }
  }
}
